# Demo/research only. install.sh creates distinct random secrets on first setup.
# Never commit .env. Existing signing keys must be preserved during migration.
GUARDIAN_PROFILE=demo
API_KEY=CHANGE_ME
LOG_HMAC_KEY=CHANGE_ME
TASK_API_KEY=CHANGE_ME
UI_USERNAME=guardian
UI_PASSWORD=CHANGE_ME
SYSTEM_ONE_API_KEY=CHANGE_ME

# Local inference by default; no automatic cloud fallback.
LLM_PROVIDER=llama.cpp
LLM_API_BASE=http://llama:8080/v1
LLM_API_KEY=CHANGE_ME
EXECUTOR_HMAC_KEY=CHANGE_ME
EXECUTOR_URL=
LLM_MODEL=qwen2.5-3b-instruct
LLM_MODEL_CODER=qwen2.5-3b-instruct
INTENT_LLM_MODEL=openai/qwen2.5-3b-instruct
LLM_MODEL_EXPLAIN=qwen2.5-3b-instruct

# Only meaningful with the full profile or the system-one Compose profile.
# Without that optional service, shadow status is unavailable, not safe.
SYSTEM_ONE_URL=http://system-one:8009/v1/systemone
SYSTEM_ONE_TIMEOUT_SECONDS=0.5
SYSTEM_ONE_THREADS=8

# The full profile starts llama.cpp and System One and uses the pinned GGUF.
# COMPOSE_PROFILES=full
# LLAMA_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
# INTENT_LLM_TIMEOUT_SECONDS=30
# GUARDIAN_TIMEOUT_SECONDS=45

GUARDIAN_BIND_IP=127.0.0.1
GUARDIAN_PORT=5000
AGENT_PORT=5001
UI_PORT=8081
# Match ownership of state/ (the installer fills these automatically).
LOCAL_UID=1000
LOCAL_GID=1000
RATE_LIMIT_STORAGE_URI=memory://

# Dry-run is the default. This is NOT an OS-level sandbox switch.
# Real execution additionally requires an operator-registered task_id.
EXECUTE_COMMANDS=false

# Optional generation providers. Selecting one sends task data to that provider.
# Set LLM_PROVIDER and the matching LLM_MODEL_CODER explicitly before use.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
